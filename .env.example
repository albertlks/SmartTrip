# Copy to .env.local and fill in. Never commit .env.local.

# LLM for `npm run plan` / `npm run demo*`. OpenRouter is used when its key is set,
# otherwise the course gateway.
LLM_API_KEY=
# OPENROUTER_API_KEY=

# Where searchFlights gets data: mock (default, no key needed) | fixture | serpapi
#   mock     data/flights.json
#   fixture  a saved real SerpApi response in data/fixtures/, matched by route and dates
#   serpapi  live Google Flights via SerpApi, cached 24h in data/cache/ (free plan: 250 searches/month)
FLIGHT_PROVIDER=mock

# Needed only for FLIGHT_PROVIDER=serpapi. Get one at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# To save a fixture (uses 1 search). Removes your key, search_metadata, and the departure/booking
# tokens (unused, and secret scanners flag them as high-entropy strings):
#   curl -s "https://serpapi.com/search?engine=google_flights&departure_id=HNL&arrival_id=SEA&outbound_date=2026-10-21&return_date=2026-10-27&type=1&adults=1&currency=USD&api_key=$SERPAPI_API_KEY" \
#     | sed "s/$SERPAPI_API_KEY/REDACTED/g" \
#     | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>console.log(JSON.stringify(JSON.parse(s,(k,v)=>["departure_token","booking_token","search_metadata"].includes(k)?undefined:v),null,2)))' \
#     > data/fixtures/serpapi-flights-HNL-SEA-2026-10-21-2026-10-27.json
